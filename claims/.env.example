# Build-time settings for local `astro build`. On Cloudflare, non-secret values come from wrangler.toml
# (scripts/build-env.mjs) and CF_D1_API_TOKEN / CF_ACCOUNT_ID are encrypted secrets in the dashboard.
# Public origin and base path. Use CLAIMS_BASE=/claims only if served at www.scopit.work/claims/.
CLAIMS_SITE=https://claims.scopit.work
CLAIMS_BASE=/
# production | preview | development. Production builds refuse fixtures and require the D1 source.
CLAIMS_ENV=production

# Directory source: d1 (production/preview), fixture (local only), or empty (empty directory).
CLAIMS_DIRECTORY_SOURCE=d1
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# API token with only "Account > D1 > Read". Secret: set it as an encrypted build variable.
CF_D1_API_TOKEN=

# Public values baked into pages (not secret).
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_PLAUSIBLE_DOMAIN=claims.scopit.work
PUBLIC_CONTACT_EMAIL=hello@scopit.work
# Optional: Google Search Console HTML-tag token (DNS verification is preferred).
PUBLIC_GSC_VERIFICATION=
