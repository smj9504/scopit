---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, PUBLIC_CONFIG, type Section } from '../site';

export interface Props {
  title: string;
  description: string;
  /** Site path without the base, e.g. "/guides/". */
  path: string;
  section: Section;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  /** Load the Cloudflare Turnstile script (form pages only). */
  turnstile?: boolean;
}

const { section, path, turnstile = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f4ee" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={href('/fonts/ibm-plex-sans-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={href('/fonts/ibm-plex-sans-latin-700-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('/sitemap.xml')} />
    <Seo path={path} {...seo} />
    {
      PUBLIC_CONFIG.plausibleDomain && (
        <script is:inline defer data-domain={PUBLIC_CONFIG.plausibleDomain} src={PUBLIC_CONFIG.plausibleSrc} />
      )
    }
    {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
  </head>
  <body data-section={section}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header section={section} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
