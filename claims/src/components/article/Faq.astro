---
interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="faq" aria-labelledby="questions">
      <h2 id="questions">Common questions</h2>
      {items.map((f) => (
        <div class="faq__item">
          <h3>{f.question}</h3>
          <p>{f.answer}</p>
        </div>
      ))}
    </section>
  )
}

<style>
  .faq__item {
    border-top: var(--hair);
    padding-top: var(--space-2);
    margin-top: var(--space-2);
  }
  .faq__item h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
</style>
