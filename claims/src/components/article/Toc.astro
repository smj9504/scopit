---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  extra?: { slug: string; text: string }[];
}

const { headings, extra = [] } = Astro.props;
const items = [...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })), ...extra];
---

{
  items.length > 1 && (
    <nav class="toc" aria-labelledby="toc-title">
      <p class="label toc__title" id="toc-title">
        On this page
      </p>
      <ol>
        {items.map((h, i) => (
          <li>
            <a href={`#${h.slug}`}>
              <span class="toc__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{h.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    border-top: var(--rule);
    padding-top: 0.75rem;
  }
  .toc__title {
    margin-bottom: 0.5rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    border-bottom: var(--hair);
  }
  .toc a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem;
    padding: 0.55rem 0;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.4;
  }
  .toc a:hover span:last-child {
    text-decoration: underline;
  }
  .toc__num {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    padding-top: 0.1rem;
  }
</style>
