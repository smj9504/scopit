---
/**
 * Shared header. Two separate nav groups (homeowners, adjusters) so the two
 * audiences never land in each other's section by accident. No JavaScript:
 * on small screens the groups stack instead of hiding behind a menu.
 */
import { href, SITE, type Section } from '../site';



interface Props {
  section: Section;
  /** Site path of the current page, used to mark the current link. */
  path: string;
}

const { section, path } = Astro.props;

const homeowners = [
  { label: 'Guides', path: '/guides/' },
  { label: 'Find an adjuster', path: '/find-an-adjuster/' },
];
const adjusters = [
  { label: 'Estimating notes', path: '/for-adjusters/notes/' },
  { label: 'Get listed', path: '/for-adjusters/apply/' },
];

function isCurrent(linkPath: string) {
  const clean = linkPath.split('#')[0] ?? linkPath;
  if (clean === '/for-adjusters/notes/') return path.startsWith('/for-adjusters/notes/');
  return path === clean || (clean !== '/' && path.startsWith(clean));
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={href('/')}>
      <span class="orb brand__orb" aria-hidden="true"></span>
      <span class="brand__name">Scopit</span>{' '}<span class="brand__tag">Claims</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <div class:list={['nav-group', { 'nav-group--active': section === 'homeowners' }]}>
        <a class="nav-group__label" href={href('/')} aria-current={path === '/' ? 'page' : undefined}><span class="nav-group__for">For&nbsp;</span>homeowners</a>
        <ul>
          {
            homeowners.map((l) => (
              <li>
                <a href={href(l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class:list={['nav-group', { 'nav-group--active': section === 'adjusters' }]}>
        <a class="nav-group__label" href={href('/for-adjusters/')} aria-current={path === '/for-adjusters/' ? 'page' : undefined}
          ><span class="nav-group__for">For&nbsp;</span>adjusters</a
        >
        <ul>
          {
            adjusters.map((l) => (
              <li>
                <a href={href(l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
    <div class="site-header__end">
      {SITE.communityUrl && <a class="site-header__link" href={SITE.communityUrl}>Community</a>}
      <a class="site-header__link" href={href('/about/')} aria-current={path === '/about/' ? 'page' : undefined}>About</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rail);
    background: var(--bg);
  }
  /* Phones and tablets: brand and About on top, the two nav groups below.
     Wide screens: one row. */
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand end'
      'nav nav';
    align-items: center;
    column-gap: 2rem;
  }
  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 64px;
    color: var(--ink);
    text-decoration: none;
    justify-self: start;
  }
  .brand__orb {
    --orb: 22px;
    margin-right: 0.3rem;
  }
  .brand__name {
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
  }
  .brand__tag {
    font-weight: 400;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  .site-header__end {
    grid-area: end;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .site-header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.875rem;
    border-radius: var(--pill);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }
  .site-header__link:hover {
    background: var(--paper);
  }
  .site-header__link[aria-current='page'] {
    background: var(--paper);
  }
  .site-nav {
    grid-area: nav;
    display: grid;
    border-top: 1px solid var(--rail);
  }
  .nav-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.25rem;
    min-height: 52px;
  }
  .nav-group + .nav-group {
    border-top: 1px solid var(--rail);
  }
  .nav-group__label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }
  .nav-group__label:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .nav-group--active .nav-group__label {
    color: var(--ink);
  }
  .nav-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.125rem;
  }
  .nav-group li a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 0.75rem;
    border-radius: var(--pill);
    color: var(--ink-soft);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }
  .nav-group li a:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .nav-group li a[aria-current='page'] {
    background: var(--paper);
    color: var(--ink);
  }
  .nav-group__label[aria-current='page'] {
    color: var(--ink);
  }
  @media (max-width: 599px) {
    .nav-group {
      flex-wrap: nowrap;
    }
    .nav-group__for {
      display: none;
    }
    .nav-group__label {
      flex: 0 0 auto;
      min-width: 6.25rem;
      margin-right: 0;
    }
    .nav-group li a {
      padding: 0 0.6rem;
    }
  }
  @media (min-width: 1040px) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav end';
    }
    .site-nav {
      grid-template-columns: auto auto;
      justify-content: start;
      border-top: 0;
    }
    .nav-group {
      min-height: 64px;
    }
    .nav-group + .nav-group {
      border-top: 0;
      border-left: 1px solid var(--rail);
      margin-left: 1rem;
      padding-left: 1rem;
    }
  }
</style>
