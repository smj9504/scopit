---
import { href, SITE } from '../site';
import { DISCLOSURE, GENERAL_DISCLAIMER } from '../shared/constants';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__frame">
    <section class="invite" aria-labelledby="invite-title">
      <span class="joint joint--tl" aria-hidden="true"></span>
      <span class="joint joint--tr" aria-hidden="true"></span>
      <span class="joint joint--bl" aria-hidden="true"></span>
      <span class="joint joint--br" aria-hidden="true"></span>
      <div>
        <h2 id="invite-title">Water damage today? Start with the checklist.</h2>
        <p>Free to read. No sign-up. General information, not legal advice.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href={href('/#checklist')}>Start the checklist</a>
        <a class="btn" href={href('/find-an-adjuster/')}>Find an adjuster</a>
      </div>
    </section>
    <div class="site-footer__cols">
      <nav aria-label="For homeowners">
        <p class="label">For homeowners</p>
        <ul>
          <li><a href={href('/')}>Home</a></li>
          <li><a href={href('/guides/')}>Guides</a></li>
          <li><a href={href('/what-is-a-public-adjuster/')}>What is a public adjuster?</a></li>
          <li><a href={href('/find-an-adjuster/')}>Find an adjuster</a></li>
          {SITE.communityUrl && <li><a href={SITE.communityUrl}>Community</a></li>}
        </ul>
      </nav>
      <nav aria-label="For adjusters">
        <p class="label">For adjusters</p>
        <ul>
          <li><a href={href('/for-adjusters/')}>Estimating notes</a></li>
          <li><a href={href('/for-adjusters/apply/')}>Apply to be listed</a></li>
          <li><a href={href('/listing-terms/')}>PA Listing Terms</a></li>
        </ul>
      </nav>
      <nav aria-label="About this site">
        <p class="label">This site</p>
        <ul>
          <li><a href={href('/about/')}>About and verification</a></li>
          <li><a href={href('/contact/')}>Contact</a></li>
          <li><a href={href('/disclaimer/')}>Disclaimer</a></li>
          <li><a href={href('/privacy/')}>Privacy</a></li>
          <li><a href={href('/terms/')}>Terms</a></li>
        </ul>
      </nav>
    </div>
    <div class="site-footer__notes">
      <p class="disclosure site-footer__disclosure">{DISCLOSURE}</p>
      <p class="site-footer__legal">{GENERAL_DISCLAIMER}</p>
    </div>
    <p class="site-footer__base">
      © {year} Scopit · <a href={SITE.publisherUrl}>scopit.work</a> · Covers Virginia, Maryland, and the District of Columbia.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-5);
    padding-inline: var(--gutter);
    overflow-x: clip;
    background: var(--bg);
  }
  /* Framed like a drawing: side rails, a ruled band, small dots where lines meet. */
  .site-footer__frame {
    max-width: calc(var(--container) - 2 * var(--gutter));
    margin-inline: auto;
    border-inline: 1px solid var(--rail);
  }
  .invite {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    min-height: 190px;
    padding: var(--space-4);
    border-block: 1px solid var(--rail);
  }
  .invite h2 {
    font-size: 2rem;
    line-height: 2.25rem;
    margin: 0 0 0.5rem;
  }
  .invite p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
  }
  .joint {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
  }
  .joint--tl {
    top: -4px;
    left: -4px;
  }
  .joint--tr {
    top: -4px;
    right: -4px;
  }
  .joint--bl {
    bottom: -4px;
    left: -4px;
  }
  .joint--br {
    bottom: -4px;
    right: -4px;
  }
  .site-footer__cols {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-3);
  }
  @media (min-width: 720px) {
    .site-footer__cols {
      grid-template-columns: repeat(3, minmax(0, 16rem));
    }
  }
  .site-footer .label {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer li a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .site-footer li a:hover {
    text-decoration: underline;
  }
  .site-footer__notes {
    display: grid;
    gap: 0.75rem;
    padding: 0 var(--space-4) var(--space-4);
  }
  .site-footer__disclosure {
    max-width: 48rem;
    justify-self: start;
  }
  .site-footer__legal {
    color: var(--muted);
    font-size: 0.875rem;
    max-width: 70ch;
    margin: 0;
  }
  .site-footer__base {
    margin: 0;
    padding: 1rem var(--space-4);
    border-top: 1px solid var(--rail);
    color: var(--muted);
    font-size: 0.875rem;
  }
  .site-footer__base a {
    color: var(--muted);
  }
  @media (max-width: 599px) {
    .site-footer {
      padding-inline: 0;
    }
    .site-footer__frame {
      border-inline: 0;
    }
    .joint {
      display: none;
    }
    .invite,
    .site-footer__cols,
    .site-footer__notes,
    .site-footer__base {
      padding-inline: var(--gutter);
    }
    .invite h2 {
      font-size: 1.625rem;
      line-height: 2rem;
    }
  }
</style>
