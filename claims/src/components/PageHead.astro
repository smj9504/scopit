---
import { href } from '../site';
import type { Crumb } from '../seo/jsonld';

interface Props {
  crumbs: Crumb[];
  label?: string;
  title: string;
  lede?: string;
}

const { crumbs, label, title, lede } = Astro.props;
---

<header class="page-head">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        {
          crumbs.map((c, i) => (
            <li>
              {i === crumbs.length - 1 ? (
                <span aria-current="page">{c.name}</span>
              ) : (
                <a href={href(c.path)}>{c.name}</a>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    {label && <p class="label page-head__label">{label}</p>}
    <h1 set:html={title} />
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-head__label {
    margin: var(--space-3) 0 0;
  }
  .crumbs + h1 {
    margin-top: var(--space-3);
  }
</style>
