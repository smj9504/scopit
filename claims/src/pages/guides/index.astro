---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import RowList from '../../components/RowList.astro';
import { getGuides, guidePath } from '../../content-helpers';
import { breadcrumbLd } from '../../seo/jsonld';
import { href } from '../../site';

const guides = await getGuides();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
];
const items = guides.map((g) => ({
  title: g.data.title,
  description: g.data.description,
  path: guidePath(g),
  lastReviewed: g.data.lastReviewed,
  flag: g.data.status === 'published' ? undefined : 'Draft',
}));
---

<BaseLayout
  title="Home insurance claim guides for Virginia, Maryland, and DC"
  description="Plain-language guides to home insurance claims: what to do before repairs, premiums, claims after repairs, and public adjusters. VA, MD, and DC."
  path="/guides/"
  section="homeowners"
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <PageHead
    crumbs={crumbs}
    label="Guides for homeowners"
    title="Claim guides, in <mark>plain language</mark>"
    lede="Short guides for homeowners in Virginia, Maryland, and DC. Each one lists its sources and the date it was last reviewed."
  />
  <div class="container section">
    <RowList items={items} label="Guides" />
    <p class="muted guides-note">
      New to claims? Start with the <a href={href('/guides/before-you-repair-water-damage-checklist/')}>water damage checklist</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .guides-note {
    margin-top: var(--space-3);
  }
</style>
