# Where .github/workflows/community.yml deploys. Not secret. Fill in the two
# values that community/deploy/gcp-setup.sh prints at the end; until then the
# workflow builds and tests but does not deploy.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_ZONE=us-east1-b
COMMUNITY_VM=scopit-community
COMMUNITY_DOMAIN=community.scopit.work
