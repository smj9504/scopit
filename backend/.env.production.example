# Scopit Backend - Production Environment Variables
# Copy this to .env.production and fill in all values
# NEVER commit .env.production to git

# ===================
# Environment
# ===================
ENV=production
DEBUG=False

# ===================
# Database (Neon PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# ===================
DATABASE_URL=postgresql://scopit:CHANGEME@ep-xxx.us-east-1.aws.neon.tech/scopit?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ===================
# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ===================
SECRET_KEY=CHANGEME_generate_with_python
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12

# ===================
# CORS & URLs
# ===================
CORS_ORIGINS=https://scopit.work,https://www.scopit.work
FRONTEND_URL=https://scopit.work

# ===================
# Google OAuth
# From: https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: https://api.scopit.work/api/auth/google/callback
# ===================
GOOGLE_CLIENT_ID=CHANGEME
GOOGLE_CLIENT_SECRET=CHANGEME
GOOGLE_REDIRECT_URI=https://api.scopit.work/api/auth/google/callback

# ===================
# AI / Anthropic
# From: https://console.anthropic.com/keys
# ===================
ANTHROPIC_API_KEY=CHANGEME
VISION_BATCH_INTER_ROOM_DELAY=0.5
VISION_BATCH_MAX_ROOMS=15
VISION_RATE_LIMIT_RETRIES=3
VISION_RATE_LIMIT_BASE_DELAY=2.0

# ===================
# Beta Mode
# ===================
BETA_MODE=True
BETA_END_DATE=2026-09-30

# ===================
# Email
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASSWORD=CHANGEME
EMAIL_FROM=CHANGEME
EMAIL_FROM_NAME=Scopit

# ===================
# Geoapify (Address Autocomplete)
# From: https://myprojects.geoapify.com
# ===================
GEOAPIFY_API_KEY=CHANGEME

# ===================
# File Storage (Cloudflare R2)
# Create bucket at: https://dash.cloudflare.com → R2
# Create API token: R2 → Manage R2 API Tokens
# ===================
STORAGE_PROVIDER=r2
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGEME
R2_SECRET_ACCESS_KEY=CHANGEME
R2_BUCKET_NAME=scopit-uploads

# ===================
# Token Expiry
# ===================
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
