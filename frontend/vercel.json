{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/demo/packing",
      "destination": "/demo/packing/index.html"
    },
    {
      "source": "/packing-calculator",
      "destination": "/packing-calculator/index.html"
    },
    {
      "source": "/pack-out-estimate",
      "destination": "/pack-out-estimate/index.html"
    },
    {
      "source": "/insurance-packing-estimate",
      "destination": "/insurance-packing-estimate/index.html"
    },
    {
      "source": "/packing-report",
      "destination": "/packing-report/index.html"
    },
    {
      "source": "/packing-estimate",
      "destination": "/packing-estimate/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
