{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/demo/packing",
      "destination": "/demo/packing/index.html"
    },
    {
      "source": "/packing-calculator",
      "destination": "/packing-calculator/index.html"
    },
    {
      "source": "/pack-out-estimate",
      "destination": "/pack-out-estimate/index.html"
    },
    {
      "source": "/insurance-packing-estimate",
      "destination": "/insurance-packing-estimate/index.html"
    },
    {
      "source": "/packing-report",
      "destination": "/packing-report/index.html"
    },
    {
      "source": "/xactimate-packing-estimate",
      "destination": "/xactimate-packing-estimate/index.html"
    },
    {
      "source": "/water-damage-contents-estimate",
      "destination": "/water-damage-contents-estimate/index.html"
    },
    {
      "source": "/fire-damage-contents-estimate",
      "destination": "/fire-damage-contents-estimate/index.html"
    },
    {
      "source": "/in-person-contract-signing",
      "destination": "/in-person-contract-signing/index.html"
    },
    {
      "source": "/kitchen-cabinet-estimate",
      "destination": "/kitchen-cabinet-estimate/index.html"
    },
    {
      "source": "/bathroom-estimate",
      "destination": "/bathroom-estimate/index.html"
    },
    {
      "source": "/packing-estimate",
      "destination": "/packing-estimate/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/sign/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/sign-in-person/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/packing-estimate/verify/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/packing-estimate/result/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
